# ==============================================================================
# BIDVEDA MINI RFQ PORTAL — DOCKER ENVIRONMENT CONFIGURATION
# Copy this file to .env before running docker compose
# ==============================================================================

# ── Project Info ──────────────────────────────────────────────────────────────
PROJECT_NAME="Bidveda RFQ Portal"
SERVER_HOST="http://localhost:8000"
FRONTEND_URL="http://localhost:3000"
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# ── Neon PostgreSQL Database Connection ───────────────────────────────────────
# Enter your Neon connection string below (either postgresql:// or postgresql+asyncpg://)
# Format: postgresql+asyncpg://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/[dbname]?ssl=require
DATABASE_URL="postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?ssl=require"

# ── Auth & Security ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=300
REFRESH_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# ── Database Automation Flags ─────────────────────────────────────────────────
# Set RUN_MIGRATIONS=true to automatically apply 'alembic upgrade head' on startup
RUN_MIGRATIONS=true
# Set RUN_SEED=true to seed initial demo accounts & sample RFQs on container startup
RUN_SEED=false

# ── Frontend Configuration ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# ── Storage Configuration ─────────────────────────────────────────────────────
# "local" (saved to persistent Docker volume) or "s3" (AWS / Backblaze B2 / Cloudflare R2)
STORAGE_PROVIDER="local"
AWS_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION_NAME=""
AWS_BUCKET_NAME=""

# ── Email Service ─────────────────────────────────────────────────────────────
# "smtp" or "resend"
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL=""
RESEND_API_KEY=""
