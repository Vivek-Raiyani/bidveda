# =============================================================================
# PRODUCTION ENVIRONMENT — ClickCapturr Backend
# Set all of these in Coolify under Environment Variables for the backend service
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
PROJECT_NAME="ClickCapturr"
SERVER_HOST="http://localhost:8000"
FRONTEND_URL="http://localhost:3000"
BACKEND_CORS_ORIGINS='["*"]'

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite — file lives in the persistent volume mounted at /app/data
DATABASE_URL="sqlite+aiosqlite:///./test.db"

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY="generate-a-strong-secret-key-here-and-keep-it-secret"                      # Generate: openssl rand -hex 32
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=300
REFRESH_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false                 # Always true when served over HTTPS

# ── Storage (Backblaze B2 via S3-compatible API) ──────────────────────────────
STORAGE_PROVIDER="s3"
AWS_ENDPOINT="https://s3.us-east-005.backblazeb2.com"   # your B2 endpoint
AWS_ACCESS_KEY_ID="005ae2612fc59560000000001"               # B2 keyID
AWS_SECRET_ACCESS_KEY="K0053M+/lFja3M+Ih1CiTlEGPdmOgac"          # B2 applicationKey
AWS_REGION_NAME="us-east-005"      # your B2 region
AWS_BUCKET_NAME="clickcapture"                   # your B2 bucket name

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER="smtp"              # or "resend"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL=""  # Optional: if using alias or send as functionlilty
EMAILS_FROM_NAME=""    # Optional: display name shown in email From header
RESEND_API_KEY=""                  # Only needed if EMAIL_PROVIDER=resend
